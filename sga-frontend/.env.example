# Variáveis de ambiente do Frontend (SGA React)
# Copie este arquivo para .env.local para desenvolvimento local.
# Para produção, configure no painel do Vercel (Settings → Environment Variables).

# -------------------------------------------------------------------
# URL da API (Backend)
# -------------------------------------------------------------------
# URL base da API do backend.
# Desenvolvimento: http://localhost:3001/api
# Produção: URL do seu serviço no Render (ex: https://sga-api.onrender.com/api)
REACT_APP_API_URL=http://localhost:3001/api
