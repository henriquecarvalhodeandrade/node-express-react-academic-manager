# Variáveis de ambiente do Backend (SGA API)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env no repositório.

# -------------------------------------------------------------------
# Banco de Dados MySQL
# -------------------------------------------------------------------
# Host do servidor MySQL (ex: localhost em dev, hostname do PlanetScale/Railway em prod)
DB_HOST=localhost

# Usuário do MySQL
DB_USER=root

# Senha do MySQL (use uma senha forte em produção)
DB_PASSWORD=

# Nome do banco de dados
DB_DATABASE=sga_db

# Porta do MySQL (padrão: 3306)
DB_PORT=3306

# -------------------------------------------------------------------
# Sessão
# -------------------------------------------------------------------
# Chave secreta para assinar o cookie de sessão.
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------
# URL do frontend que terá permissão para acessar a API.
# Desenvolvimento: http://localhost:3000
# Produção: URL completa do Vercel (ex: https://sga-academico.vercel.app)
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------
# Ambiente
# -------------------------------------------------------------------
# Define o ambiente de execução. Use "production" no Render.
NODE_ENV=development

# Porta do servidor (Render define automaticamente via PORT)
PORT=3001
